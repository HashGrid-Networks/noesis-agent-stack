{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noesis.agent-stack/orchestration/delegated-task/v1",
  "title": "noesis.delegated-task/v1",
  "description": "Durable orchestrator-specialist handoff and delegated-task state record. Persisted as append-only JSONL snapshots; latest version per task id wins on replay.",
  "type": "object",
  "required": [
    "task_id",
    "contract_revision",
    "root_task_id",
    "correlation_id",
    "assignee_profile",
    "required_capability",
    "intent",
    "acceptance_criteria",
    "state",
    "version",
    "assignment_epoch"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "contract_revision": {
      "type": "string"
    },
    "root_task_id": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "assignee_profile": {
      "type": "string"
    },
    "required_capability": {
      "type": "string"
    },
    "intent": {
      "type": "string"
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contract": {
      "type": "object"
    },
    "state": {
      "type": "string",
      "enum": [
        "pending",
        "ready",
        "assigned",
        "running",
        "verifying",
        "spec_review",
        "quality_review",
        "completed",
        "blocked",
        "cancelled",
        "failed"
      ]
    },
    "version": {
      "type": "integer"
    },
    "assignment_epoch": {
      "type": "integer"
    },
    "candidate_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "accepted": {
      "type": "boolean"
    },
    "lease": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "holder": {
          "type": "string"
        },
        "epoch": {
          "type": "integer"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "revoked": {
          "type": "boolean"
        },
        "attempt_epoch": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "execution_released_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "holder",
        "epoch",
        "issued_at",
        "expires_at"
      ]
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stage",
          "verdict",
          "reviewer",
          "candidate_revision"
        ],
        "properties": {
          "stage": {
            "enum": [
              "spec",
              "quality",
              "integration"
            ]
          },
          "verdict": {
            "type": "string"
          },
          "reviewer": {
            "type": "string"
          },
          "candidate_revision": {
            "type": "string"
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_event": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "budget_reserved": {
      "type": "number",
      "default": 0.0
    },
    "budget_consumed": {
      "type": "number",
      "default": 0.0
    }
  }
}